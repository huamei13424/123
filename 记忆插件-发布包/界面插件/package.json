{
  "name": "@local/memory-panel",
  "version": "0.7.2",
  "private": true,
  "type": "module",
  "description": "记忆插件 v7.2：继承既存会话及其他（旧会话→独立链/指定链）/ 会话菜单删记忆档案 / 管理链（删除+改名+重排）+ Host 事件钩子",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "instructions.md",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
